# WesternHillsAgent public repository exclusions

# CMake / Qt Creator generated output
/build/
/build-*/
/cmake-build-*/
/CMakeCache.txt
/CMakeFiles/
/cmake_install.cmake
/compile_commands.json
/.qtcreator/
/.qtc_clangd/
*.user
*.user.*
*.autosave

# Generated binaries and object files
*.o
*.obj
*.a
*.so
*.so.*
*.dll
*.dylib
*.exe
WesternHillsAgent

# Logs, temporary and editor files
*.log
*.tmp
*.swp
*.swo
*~
.DS_Store

# Local credentials and secrets: never commit these
.env
.env.*
*.pem
*.key
*.p12
*.pfx
*.kdbx
credentials
credentials.*
secrets
secrets.*

# Local databases / runtime state: never commit these
*.db
*.sqlite
*.sqlite3

# Flatpak local build output
/.flatpak-builder/
/flatpak-build/
/flatpak-repo/
*.flatpak

# Snapcraft local build output
/parts/
/prime/
/stage/
*.snap

# Distribution output generated by this script
/dist/*
!/dist/.gitkeep
